<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>VideoShowBoothButtons</RootNamespace>
    <AssemblyName>VideoShowBoothButtons</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 编译后自动打包为 .icpx 插件包（能力由 InkCanvas.PluginSdk.targets 注入） -->
    <CreateIcpx>true</CreateIcpx>
  </PropertyGroup>

  <ItemGroup>
    <!-- 经 NuGet 引用宿主 SDK（CI/分发用）。Private=false + ExcludeAssets=runtime：
         生成物不携带 SDK dll，运行时由宿主统一提供，包内也不会出现 SDK 程序集。
         CreateIcpx 打包与 manifest.json 复制能力由包内自带的 InkCanvas.PluginSdk.targets 注入。 -->
    <PackageReference Include="InkCanvas.PluginSdk" Version="1.8.0.6-g569fef5e70"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
