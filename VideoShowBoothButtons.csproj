<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>VideoShowBoothButtons</RootNamespace>
    <AssemblyName>VideoShowBoothButtons</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 编译后自动打包为 .icpx 插件包（能力由 InkCanvas.PluginSdk.targets 注入） -->
    <CreateIcpx>true</CreateIcpx>
  </PropertyGroup>

  <ItemGroup>
    <!-- 直接引用本地 community 仓库的 SDK 源项目（含未发版的 IVideoBoothService，API 1.11.0）。
         待 SDK 发上新版 NuGet 后可改为：PackageReference Include="InkCanvas.PluginSdk" Version="x.y.z"。
         Private=false + ExcludeAssets=runtime：生成物不携带 SDK dll，运行时由宿主统一提供。 -->
    <ProjectReference Include="C:\Users\PrefacedCorg\Documents\GitHub\community\InkCanvas.PluginSdk\InkCanvas.PluginSdk.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>
  <!-- 本地开发用 ProjectReference 引 SDK 时，.targets 不会自动注入（NuGet 包才会），
       这里手动导入以获得 CreateIcpx 打包与 manifest.json 复制能力。切回 PackageReference 后可删除此 Import。 -->
  <Import Project="C:\Users\PrefacedCorg\Documents\GitHub\community\InkCanvas.PluginSdk\InkCanvas.PluginSdk.targets" />

</Project>
